meta {
  name: Lister les credentials
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/credentials
  body: none
  auth: none
}

tests {
  test("3 credentials par identité", () => expect(res.body.length % 3).to.equal(0));
}

docs {
  Tous les credentials de toutes les identités, avec leurs claims en clair.

  - `id` : `<identityId>:pid-sd-jwt`, `<identityId>:pid-mdoc` ou `<identityId>:mdl-mdoc`
  - `format` : `dc+sd-jwt` ou `mso_mdoc`
  - `type` : `vct` (SD-JWT VC) ou `doctype` (mdoc)
  - `claims` : SD-JWT = objet JSON reconstitué ; mdoc = `namespace → élément → valeur` (notation diagnostic CBOR)
}
