meta {
  name: 4. Accepter
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/presentations/{{presentationId}}/accept
  body: json
  auth: none
}

body:json {
  { "faults": [] }
}

tests {
  test("accepté par le verifier", () => expect(res.body.accepted, JSON.stringify(res.body)).to.equal(true));
}

docs {
  Réponse chiffrée JWE (ECDH-ES) postée sur le `response_uri` du verifier. Si le verifier refuse, le `502`
  contient son message (`InvalidVpToken` + cause). Essayer aussi avec un `faults` pour vérifier qu'il rejette.
}
